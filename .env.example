# =============================================================================
# sparshit — environment variables. Copy to .env.local for development; in
# production pass them to the container at RUNTIME (docker --env-file / -e).
# All are server-side only: never prefix them with NEXT_PUBLIC_.
# =============================================================================

# ---- Website forms → sparsh-backend (admin → Sparshit inbox) ----------------
# sparsh-backend base URL INCLUDING /api/v1.
#   production: https://apis.sparshinfosystem.com/api/v1
#   local:      http://localhost:3000/api/v1
BACKEND_API_URL=
# Shared secret; must equal WEBSITE_API_KEY in sparsh-backend.
# Generate once per environment: openssl rand -hex 32
WEBSITE_API_KEY=

# ---- Notification emails (SMTP) ---------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sparsh IT
# Inbox for enquiries + project briefs
MAIL_TO_ADDRESS=
# Inbox for job applications
MAIL_FROM_CAREER=
# Optional, development only
MAIL_ALLOW_INSECURE_TLS=false
SPARSH_APPLICATION_ENV=
MAIL_FOR_TEST=
